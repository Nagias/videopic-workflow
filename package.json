{
  "name": "videopic-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server.ts",
    "dev:web": "vite",
    "start": "vite build && tsx src/server.ts --serve-web",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "verify:full": "npm run verify && npm run test:e2e",
    "gen:nodes": "tsx scripts/gen-nodes.ts",
    "new:node": "tsx scripts/new-node.ts",
    "db:generate": "drizzle-kit generate",
    "muse:login": "tsx scripts/muse-login.ts",
    "smoke:muse": "tsx scripts/smoke-muse.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "@xyflow/react": "12.12.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild": false,
    "better-sqlite3": false
  }
}
